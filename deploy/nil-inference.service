[Unit]
Description=NIL single-tenant TLS inference reference
After=network.target

[Service]
Type=simple
User=nil
Group=nil
WorkingDirectory=/opt/nil/app
Environment=PATH=/opt/nil/venv/bin:/usr/bin
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
ExecStart=/opt/nil/venv/bin/python -m nil.serving --config /etc/nil/service.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillMode=control-group
MemoryMax=1G
MemorySwapMax=0
CPUQuota=100%
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
